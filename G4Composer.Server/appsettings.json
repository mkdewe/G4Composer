{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "G4Composer.Server.Controllers.QuadroController": "Debug",
      "G4Composer.Server.Services.QuadroJobRunner": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Dev: SQLite — plik g4composer.db powstanie w katalogu projektu przy pierwszym uruchomieniu.
    // Prod: podmień na "Host=localhost;Database=g4composer;Username=g4;Password=secret"
    //       i zmień UseSqlite → UseNpgsql w DatabaseServiceCollectionExtensions.cs
    "Default": "Data Source=g4composer.db"
  },

  "Quadro": {
    // Aktywna wersja silnika - musi pasować do klucza w "Engines" niżej.
    // Aby cofnąć się do 14L: zmień na "14L", prefix kontenera na "q14l"
    // i AlternativeExecutable na "alternatywa14L.exe" - reszta bez zmian.
    "Version": "14N",

    // Prefiks nazw kontenerów Docker (np. q14n_<jobId>_<struct>). Pomaga rozróżniać wersje w `docker ps`.
    "ContainerNamePrefix": "q14n",

    // Limit czasu na pojedynczy job w sekundach.
    // 14N robi jeden pełny przelot na każdą wartość iteration_steps (domyślnie 6), więc czas
    // rośnie liniowo z ich liczbą. Zmierzone: ~3 s/przelot dla typowej struktury, ~11 s dla
    // 83-meru → ~70 s w najgorszym razie. 900 s daje zapas na tryb wsadowy.
    "TimeoutSeconds": 900,

    // Executable name for the alternative run (parallel dual-run).
    // Set to null to disable. Must exist in the same Docker image as the active engine.
    "AlternativeExecutable": "alternatywa14N.exe",

    // Ścieżki wewnątrz kontenera (zwykle nie trzeba ruszać).
    "ContainerWorkDirectory": "/opt/bin",
    "ContainerDataDirectory": "/data",

    // Konfiguracja per-wersja. Aby dodać nową (np. 14M):
    //   1. dorzuć tu wpis,
    //   2. dodaj klasę Quadro14MEngine : QuadroEngineBase,
    //   3. zarejestruj w QuadroServiceCollectionExtensions.
    "Engines": {
      "14G": {
        "Image":      "quadro14g:latest",
        "Executable": "quadro14G.exe"
      },
      "14L": {
        "Image":      "quadro14l:latest",
        "Executable": "quadro14L.exe"
      },
      "14N": {
        "Image":      "quadro14n:latest",
        "Executable": "quadro14N.exe"
      }
    }
  }
}
