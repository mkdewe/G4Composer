{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "G4Composer.Server.Controllers.Quadro11Controller": "Debug"
    }
  },
  "AllowedHosts": "*",

  "Quadro11": {
    // Katalog roboczy – musi być dostępny zarówno dla hosta jak i Dockera
    // Na Linux/Mac: wystarczy dowolna ścieżka
    // Na Windows z Docker Desktop: użyj ścieżki pod C:\Users\ lub skonfiguruj File Sharing
    "WorkDir": "/tmp/g4composer",
    "DockerImage": "quadro11:latest",

    // Timeout w sekundach na jeden job (domyślnie 5 minut)
    "TimeoutSeconds": 300
  }
}
